// ============================================================
// WDP301 — Grafana Alloy Configuration (Ultra-Lightweight Agent)
// Chức năng:
//   1. Thu thập Host RAM, CPU, Disk từ VPS Host
//   2. Scrape API Latency (/metrics) từ wdp301-gateway
//   3. Đẩy thẳng (Remote Write) lên Grafana Cloud Free Tier
// RAM tiêu thụ: ~35MB
// ============================================================

// ─── 1. Thu thập phần cứng VPS (Host System Exporter) ────────
prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/host/rootfs"
}

prometheus.scrape "host_metrics" {
  targets    = prometheus.exporter.unix.host.targets
  forward_to = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = "15s"
}

// ─── 2. Thu thập API Latency từ API Gateway ──────────────────
prometheus.scrape "gateway_metrics" {
  targets = [{
    __address__ = "api-gateway:4000",
    app         = "wdp301-gateway",
    env         = "production",
  }]
  metrics_path = "/metrics"
  forward_to   = [prometheus.remote_write.grafana_cloud.receiver]
  scrape_interval = "10s"
}

// ─── 3. Đẩy lên Grafana Cloud qua Remote Write ────────────────
prometheus.remote_write "grafana_cloud" {
  endpoint {
    url = env("GRAFANA_CLOUD_PROMETHEUS_URL")

    basic_auth {
      username = env("GRAFANA_CLOUD_PROMETHEUS_USER")
      password = env("GRAFANA_CLOUD_API_KEY")
    }
  }
}
