{
  "name": "mobile",
  "version": "1.0.0",
  "type": "commonjs",
  "main": "index.ts",
  "scripts": {
    "postinstall": "node scripts/patch-notify-kit.js",
    "test": "jest",
    "start": "expo start --port 8085",
    "go": "expo start --go --port 8085",
    "go:clean": "expo start --go -c --port 8085",
    "dev": "expo start --port 8085",
    "prebuild": "expo prebuild --clean",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:android:apk": "eas build --platform android --profile preview-android",
    "build:android:aab": "eas build --platform android --profile production",
    "build:android:local": "expo run:android --variant release",
    "build:ios:sim": "eas build --platform ios --profile preview-ios",
    "build:ios:ipa": "eas build --platform ios --profile production",
    "build:ios:local": "expo run:ios --configuration Release"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-navigation/bottom-tabs": "^7.15.2",
    "@react-navigation/native": "^7.1.31",
    "@react-navigation/native-stack": "^7.14.2",
    "@types/node-forge": "^1.3.14",
    "d3-path": "^3.1.0",
    "d3-shape": "^3.2.0",
    "expo": "58.0.21",
    "expo-auth-session": "~58.0.16",
    "expo-calendar": "~58.0.6",
    "expo-camera": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-image": "~58.0.0",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-local-authentication": "~58.0.2",
    "expo-location": "~58.0.20",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.8",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "expo-task-manager": "~58.0.13",
    "expo-web-browser": "~58.0.7",
    "nativewind": "^2.0.11",
    "node-forge": "^1.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-biometrics": "^3.0.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-notify-kit": "^10.10.0",
    "react-native-qrcode-svg": "^6.3.16",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "jest": "^30.5.2",
    "tailwindcss": "^3.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "~6.0.3"
  },
  "private": true
}
