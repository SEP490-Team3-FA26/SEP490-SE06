{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview-android": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://abcpharmacy.store",
        "EXPO_PUBLIC_AI_URL": "https://abcpharmacy.store"
      }
    },
    "preview-ios": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://abcpharmacy.store",
        "EXPO_PUBLIC_AI_URL": "https://abcpharmacy.store"
      }
    },
    "preview-ios-device": {
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://abcpharmacy.store",
        "EXPO_PUBLIC_AI_URL": "https://abcpharmacy.store"
      }
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "distribution": "store"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://abcpharmacy.store",
        "EXPO_PUBLIC_AI_URL": "https://abcpharmacy.store"
      }
    },
    "production-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://abcpharmacy.store",
        "EXPO_PUBLIC_AI_URL": "https://abcpharmacy.store"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
