{
  "cli": {
    "version": ">= 18.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://abcpharmacy.store",
        "EXPO_PUBLIC_AI_URL": "https://ai-service-v1-production.up.railway.app"
      }
    },
    "production": {
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://abcpharmacy.store",
        "EXPO_PUBLIC_AI_URL": "https://ai-service-v1-production.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
