# Vector Database (Qdrant)
# Hỗ trợ đa dạng môi trường VPS / Docker / Cloud:
# - Docker container nội bộ: QDRANT_HOST=qdrant
# - Localhost / VPS: QDRANT_HOST=localhost (cổng 6333)
# - URL có scheme: QDRANT_URL=http://qdrant:6333 hoặc https://qdrant.phuocthanh.vn:443
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=medical_knowledge
# QDRANT_URL=http://qdrant:6333
# QDRANT_API_KEY=
# QDRANT_HTTPS=false

# OCR & Vision Services
HF_OCR_MODEL=thinkingmachines/Inkling:together
HF_TOKEN=
ROBOFLOW_API_KEY=m7tvhnXSMEGw3bYwdRyW
JWT_SECRET=wdp301-super-secret-key-change-in-production
INTERNAL_SERVICE_TOKEN=wdp301-super-secret-key-change-in-production
GRN_TOLERANCE_PERCENT=0.02

# LLM Providers
GROQ_API_KEY=
DEEPSEEK_API_KEY=
OPEN_ROUTER_API=
GEMINI_API_KEY=
COHERE_API_KEY=

# MongoDB / PostgreSQL (inherited from backend/.env if available)
# MONGODB_URI=
# DATABASE_URL=
# FRONTEND_URL=http://localhost:3000
