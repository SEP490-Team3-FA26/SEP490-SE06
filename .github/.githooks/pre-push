#!/usr/bin/env bash
# ==============================================================================
# Git Hook: pre-push
# Tự động kích hoạt Local CI Quality Gate trước khi mã nguồn được đẩy lên GitHub
# Yêu cầu: Đạt 100% Test Rules Kiến Trúc, Backend (Build + Test), Frontend (Build + Test), Mobile (Test)
# ==============================================================================

ROOT_DIR="$(git rev-parse --show-toplevel)"

echo ""
echo "🔍 [Git Pre-Push Hook] Đang kích hoạt Full CI Quality Gate (Backend, Frontend, Mobile, Build)..."
echo ""

# Chạy script kiểm tra chất lượng toàn diện trước khi push
if ! bash "$ROOT_DIR/scripts/local-ci.sh"; then
  echo ""
  echo "❌ [Git Pre-Push Hook] LỆNH PUSH ĐÃ BỊ CHẶN HOÀN TOÀN!"
  echo "👉 Phát hiện lỗi kiểm thử (Test Failed) hoặc lỗi biên dịch (Build Failed)."
  echo "👉 Vui lòng sửa hết lỗi theo thông báo chi tiết ở trên rồi mới thực hiện push lại."
  echo ""
  exit 1
fi

echo ""
echo "✅ [Git Pre-Push Hook] Toàn bộ hệ thống đạt chuẩn 100%! Cho phép đẩy mã nguồn lên GitHub..."
echo ""
exit 0
