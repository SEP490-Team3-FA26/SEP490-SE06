#!/usr/bin/env bash
# ==============================================================================
# Git Hook: pre-push
# Tự động kích hoạt Local CI Quality Gate trước khi mã nguồn được đẩy lên GitHub
# Yêu cầu: Chạy TOÀN BỘ Test Cases (backend/test & frontend/tests), KHÔNG BUILD
# ==============================================================================

ROOT_DIR="$(git rev-parse --show-toplevel)"

echo ""
echo "🔍 [Git Pre-Push Hook] Đang kiểm tra TOÀN BỘ Test Cases (Backend & Frontend) trước khi push..."
echo ""

# Chạy script kiểm tra chất lượng Local CI (Toàn bộ testcase backend & frontend)
if ! bash "$ROOT_DIR/scripts/local-ci.sh"; then
  echo ""
  echo "❌ [Git Pre-Push Hook] LỆNH PUSH ĐÃ BỊ CHẶN!"
  echo "👉 Phát hiện bài test bị thất bại hoặc vi phạm quy tắc kiểm thử. Vui lòng sửa hết lỗi rồi thực hiện push lại."
  echo "💡 Mẹo: Nếu cần push gấp để lưu nháp và bỏ qua kiểm tra, hãy thêm cờ: git push --no-verify"
  echo ""
  exit 1
fi

echo ""
echo "✅ [Git Pre-Push Hook] Toàn bộ Test Cases đều đạt chuẩn 100%! Tiến hành đẩy mã nguồn lên remote..."
echo ""
exit 0
