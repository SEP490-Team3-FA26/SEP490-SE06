#!/usr/bin/env bash
# ==============================================================================
# Husky Git Hook: pre-push
# Tự động quét lỗi cú pháp và chạy Local CI Quality Gate trước khi push
# ==============================================================================

ROOT_DIR="$(git rev-parse --show-toplevel)"

if ! node "$ROOT_DIR/scripts/check-syntax-and-safety.js"; then
  echo ""
  echo "❌ [Husky Pre-Push] LỆNH PUSH ĐÃ BỊ CHẶN DO LỖI CÚ PHÁP (SYNTAX)!"
  exit 1
fi

HOOK_ARGS="--quick"
if [ "${FULL_CI:-0}" = "1" ]; then
  HOOK_ARGS=""
fi

if ! bash "$ROOT_DIR/scripts/local-ci.sh" $HOOK_ARGS; then
  echo ""
  echo "❌ [Husky Pre-Push] LỆNH PUSH ĐÃ BỊ CHẶN BỞI LOCAL CI!"
  exit 1
fi

exit 0

