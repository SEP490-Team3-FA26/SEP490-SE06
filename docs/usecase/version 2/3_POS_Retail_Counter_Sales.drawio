          <mxGeometry x="600" y="455" width="280" height="52" as="geometry" />
        </mxCell>
        <mxCell id="uc_cancel_order" value="Cancel Order / Transaction" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4821f;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="535" width="280" height="52" as="geometry" />
        </mxCell>

        <!-- Payment Extensions (Adjacent to at y=700) -->
        <mxCell id="uc_cust_phone" value="Provide Phone for Loyalty Points" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4821f;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="700" width="280" height="52" as="geometry" />
        </mxCell>
        <mxCell id="uc_send_einvoice" value="Send E-Invoice via Email" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4821f;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="780" width="280" height="52" as="geometry" />
        </mxCell>

        <!-- EDGES: Pharmacist -->
        <mxCell id="e_1" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_pharm" target="uc_search_retail"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_2" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_pharm" target="uc_add_pos_cart"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_3" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_pharm" target="uc_scan_rx_ai"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_4" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_pharm" target="uc_confirm_ocr"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_6" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_pharm" target="uc_confirm_payment"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_7" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_pharm" target="uc_create_wholesale"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_9" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_pharm" target="uc_create_return_slip"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_10" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_pharm" target="uc_shift_close"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_11" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_pharm" target="uc_cancel_order"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- EDGES: Customer -->
        <mxCell id="e_12" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_cust" target="uc_scan_rx_ai"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_13" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_cust" target="uc_confirm_payment"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_15" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_cust" target="uc_create_return_slip"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- LOCAL SHORT INCLUDE / EXTEND -->
        <!-- extends Add Cart (directly below pointing up) -->
        <mxCell id="ext_sub_cart" value="&amp;laquo;extend&amp;raquo;" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;endSize=8;verticalAlign=middle;labelBackgroundColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;" edge="1" parent="1" source="uc_suggest_sub" target="uc_add_pos_cart">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Cross-sell extends Add Cart (directly below pointing up) -->
        <mxCell id="ext_cross_cart" value="&amp;laquo;extend&amp;raquo;" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;endSize=8;verticalAlign=middle;labelBackgroundColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;" edge="1" parent="1" source="uc_cross_sell" target="uc_add_pos_cart">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- OCR Clinical Verification Sub-routines -->
        <!-- Confirm OCR includes Check Interactions (simultaneous automated clinical safety check) -->
        <mxCell id="inc_ocr_interact" value="&amp;laquo;include&amp;raquo;" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;endSize=8;verticalAlign=middle;labelBackgroundColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;" edge="1" parent="1" source="uc_confirm_ocr" target="uc_check_interact">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Check Interactions includes Save History (simultaneous automated audit logging) -->
        <mxCell id="inc_ocr_save" value="&amp;laquo;include&amp;raquo;" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;endSize=8;verticalAlign=middle;labelBackgroundColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;" edge="1" parent="1" source="uc_check_interact" target="uc_save_ocr_history">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Payment Extensions (All optional extensions point TO Confirm Payment) -->
        <!-- Apply Voucher extends Confirm Payment (directly below pointing up) -->
        <mxCell id="ext_pay_voucher" value="&amp;laquo;extend&amp;raquo;" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;endSize=8;verticalAlign=middle;labelBackgroundColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;" edge="1" parent="1" source="uc_apply_voucher" target="uc_confirm_payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Loyalty Phone extends Confirm Payment (horizontal adjacent pointing left) -->
        <mxCell id="ext_pay_phone" value="&amp;laquo;extend&amp;raquo;" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;endSize=8;verticalAlign=middle;labelBackgroundColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;" edge="1" parent="1" source="uc_cust_phone" target="uc_confirm_payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Send E-Invoice extends Confirm Payment (horizontal adjacent pointing left) -->
        <mxCell id="ext_send_invoice" value="&amp;laquo;extend&amp;raquo;" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;endSize=8;verticalAlign=middle;labelBackgroundColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;" edge="1" parent="1" source="uc_send_einvoice" target="uc_confirm_payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Create Return Slip includes Search Return Invoice (directly above - mandatory invoice lookup) -->
        <mxCell id="inc_return_search" value="&amp;laquo;include&amp;raquo;" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;endSize=8;verticalAlign=middle;labelBackgroundColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;" edge="1" parent="1" source="uc_create_return_slip" target="uc_search_return">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Caption -->
        <mxCell id="caption" value="Figure 3 - Use Case Diagram For POS Retail and Counter Sales Module" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=13;fontColor=#004c99;" vertex="1" parent="1">
          <mxGeometry x="25" y="1125" width="1150" height="30" as="geometry" />
        </mxCell>
      </root>
