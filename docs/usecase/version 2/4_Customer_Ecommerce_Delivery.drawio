<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="4_Customer_Ecommerce_Delivery">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="920" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <!-- BOUNDARY -->
        <mxCell id="boundary" value="Pharmacy Chain - Customer E-commerce and Online Ordering Module" style="shape=rectangle;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;strokeWidth=1.5;verticalAlign=top;fontStyle=1;fontSize=14;fontColor=#000000;container=0;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="25" y="20" width="1100" height="850" as="geometry" />
        </mxCell>

        <!-- ACTORS -->
        <mxCell id="act_cust" value="Customer" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11;fontColor=#000000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="380" width="40" height="80" as="geometry" />
        </mxCell>
        <!-- Pharmacist (Packs & Dispatches) -->
        <mxCell id="act_pharm" value="Pharmacist" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11;fontColor=#000000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="120" width="40" height="80" as="geometry" />
        </mxCell>
        <!-- Internal Shipper (Delivery Driver) -->
        <mxCell id="act_shipper" value="Shipper" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#dae8fc;strokeColor=#000000;strokeWidth=1.2;fontFamily=Helvetica;fontSize=11;fontColor=#000000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="260" width="40" height="80" as="geometry" />
        </mxCell>

        <!-- LEFT COLUMN: Customer Ordering & Checkout Cluster -->
        <mxCell id="uc_search_online" value="Search Medicines Online" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4821f;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="160" y="55" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="uc_wishlist" value="Manage Wishlist (Sản phẩm yêu thích)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4821f;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="160" y="135" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="uc_add_online_cart" value="Add Medicines to Online Cart" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4821f;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="160" y="215" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="uc_manage_cart" value="Manage Personal Cart (Update / Delete)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4821f;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="160" y="295" width="280" height="55" as="geometry" />
        </mxCell>

        <!-- Order & Payment Cluster (Adjacent!) -->
        <mxCell id="uc_apply_voucher_online" value="Apply Discount Voucher Online" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4821f;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="160" y="380" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="uc_confirm_order" value="Confirm Online Order" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4821f;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="160" y="460" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="uc_pay_payos" value="Pay Online Order via PayOS (VietQR)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4821f;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="160" y="540" width="280" height="55" as="geometry" />
        </mxCell>

        <!-- Post-order & Returns -->
        <mxCell id="uc_order_history" value="View Order History" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4821f;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="160" y="630" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="uc_online_return" value="Request Return &amp; Refund Online" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4821f;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="160" y="710" width="280" height="55" as="geometry" />
        </mxCell>

        <!-- RIGHT COLUMN: Fulfillment & Delivery Cluster -->
        <mxCell id="uc_process_online" value="Process Online Orders (Pick &amp; Pack)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4821f;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="80" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="uc_assign_shipper" value="Assign Internal Shipper / Delivery" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4821f;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="165" width="280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="uc_confirm_shipping" value="Confirm Delivery Handover via QR" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4821f;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="250" width="280" height="55" as="geometry" />
        </mxCell>

        <!-- Checkout Sub-UCs: Delivery fee, Payment webhook, E-invoice -->
        <!-- Included by Confirm Online Order (system automated calculation) -->
        <mxCell id="uc_delivery_fee" value="Auto Calculate Delivery Fee by Distance" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4821f;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="420" width="280" height="55" as="geometry" />
        </mxCell>
        <!-- Included by Pay PayOS (system automated callback) -->
        <mxCell id="uc_payment_webhook" value="Auto-reconcile Online Payment (PayOS)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4821f;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="505" width="280" height="55" as="geometry" />
        </mxCell>
        <!-- Extends Pay PayOS (optional on-demand e-invoice) -->
        <mxCell id="uc_einvoice_online" value="Send E-Invoice via Email (Online Order)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f4821f;strokeColor=#000000;strokeWidth=1.2;fontColor=#000000;fontFamily=Helvetica;fontSize=11;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="600" y="590" width="280" height="55" as="geometry" />
        </mxCell>

        <!-- EDGES: Customer -->
        <mxCell id="e_1" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_cust" target="uc_search_online"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_2" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_cust" target="uc_wishlist"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_3" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_cust" target="uc_add_online_cart"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_4" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_cust" target="uc_manage_cart"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_5" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_cust" target="uc_confirm_order"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_6" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_cust" target="uc_order_history"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_7" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_cust" target="uc_online_return"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_cust_handover" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_cust" target="uc_confirm_shipping"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- EDGES: Pharmacist (Only what Pharmacist actually does) -->
        <mxCell id="e_8" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_pharm" target="uc_process_online"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e_9" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_pharm" target="uc_assign_shipper"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- EDGES: Shipper (Delivery driver scans QR to confirm handover) -->
        <mxCell id="e_ship_qr" style="edgeStyle=none;rounded=0;html=1;endArrow=none;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_shipper" target="uc_confirm_shipping"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- LOCAL SHORT INCLUDE / EXTEND -->
        <!-- Apply Voucher extends Confirm Order (directly above pointing down) -->
        <mxCell id="ext_order_voucher" value="&amp;laquo;extend&amp;raquo;" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;endSize=8;verticalAlign=middle;labelBackgroundColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;" edge="1" parent="1" source="uc_apply_voucher_online" target="uc_confirm_order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Confirm Order includes Calculate Delivery Fee (adjacent right - simultaneous mandatory) -->
        <mxCell id="inc_order_fee" value="&amp;laquo;include&amp;raquo;" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;endSize=8;verticalAlign=middle;labelBackgroundColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;" edge="1" parent="1" source="uc_confirm_order" target="uc_delivery_fee">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Confirm Order includes Pay PayOS (directly below) -->
        <mxCell id="inc_order_pay" value="&amp;laquo;include&amp;raquo;" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;endSize=8;verticalAlign=middle;labelBackgroundColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;" edge="1" parent="1" source="uc_confirm_order" target="uc_pay_payos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Pay PayOS includes Payment Webhook (adjacent right - simultaneous callback) -->
        <mxCell id="inc_pay_webhook" value="&amp;laquo;include&amp;raquo;" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;endSize=8;verticalAlign=middle;labelBackgroundColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;" edge="1" parent="1" source="uc_pay_payos" target="uc_payment_webhook">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- Send E-Invoice extends Pay PayOS (adjacent right - optional) -->
        <mxCell id="ext_order_invoice" value="&amp;laquo;extend&amp;raquo;" style="edgeStyle=none;rounded=0;html=1;dashed=1;endArrow=open;endSize=8;verticalAlign=middle;labelBackgroundColor=#ffffff;strokeColor=#000000;strokeWidth=1.2;fontSize=9;fontColor=#000000;" edge="1" parent="1" source="uc_einvoice_online" target="uc_pay_payos">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Caption -->
        <mxCell id="caption" value="Figure 4 - Use Case Diagram For Customer E-commerce and Online Ordering Module" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontStyle=1;fontSize=13;fontColor=#004c99;" vertex="1" parent="1">
          <mxGeometry x="25" y="880" width="1100" height="30" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>