        <mxCell id="e_10" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=0;strokeColor=#000000;strokeWidth=1.2;" edge="1" parent="1" source="act_cust" target="uc_receive_notif"><mxGeometry relative="1" as="geometry" /></mxCell>

